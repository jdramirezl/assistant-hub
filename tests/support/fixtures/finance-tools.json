[
 {
  "name": "finance_list_accounts",
  "title": "List accounts",
  "description": "List the user's accounts (bank, cash, investment, CD) with id, name, currency, type and current balance. Account ids are needed by most other finance_* tools.",
  "inputSchema": {
   "type": "object",
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "properties": {
    "includeArchived": {
     "default": false,
     "type": "boolean"
    },
    "includeInvestmentPrices": {
     "default": false,
     "description": "Fetch live stock prices for investment accounts (slower, rate-limited).",
     "type": "boolean"
    }
   },
   "additionalProperties": false
  },
  "annotations": {
   "title": "List accounts",
   "readOnlyHint": true,
   "destructiveHint": false,
   "openWorldHint": false
  }
 },
 {
  "name": "finance_list_pockets",
  "title": "List pockets",
  "description": "List pockets (sub-containers inside an account) with id, accountId, name, type (normal | fixed), currency and balance. Every movement belongs to one account + one pocket of that account.",
  "inputSchema": {
   "type": "object",
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "properties": {
    "accountId": {
     "type": "string",
     "format": "uuid",
     "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
     "description": "Only pockets of this account."
    },
    "includeArchived": {
     "default": false,
     "type": "boolean"
    }
   },
   "additionalProperties": false
  },
  "annotations": {
   "title": "List pockets",
   "readOnlyHint": true,
   "destructiveHint": false,
   "openWorldHint": false
  }
 },
 {
  "name": "finance_list_movements",
  "title": "List movements",
  "description": "List movements (transactions), newest first, paginated. Filter by year+month, account, pocket, pending, category or tags. Amounts are positive in the account's currency. Movement types: IngresoNormal = income, EgresoNormal = expense, IngresoFijo / EgresoFijo = income/expense on a fixed-expense (sub-pocket) budget.",
  "inputSchema": {
   "type": "object",
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "properties": {
    "year": {
     "description": "Calendar year, e.g. 2026. Requires month.",
     "type": "integer",
     "minimum": 1900,
     "maximum": 2100
    },
    "month": {
     "description": "Month 1-12. Requires year.",
     "type": "integer",
     "minimum": 1,
     "maximum": 12
    },
    "accountId": {
     "type": "string",
     "format": "uuid",
     "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
     "description": "Only movements in this account (from finance_list_accounts)."
    },
    "pocketId": {
     "type": "string",
     "format": "uuid",
     "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
     "description": "Only movements in this pocket (from finance_list_pockets)."
    },
    "pendingOnly": {
     "description": "Only pending (planned, not yet applied) movements.",
     "type": "boolean"
    },
    "category": {
     "description": "Exact category match (ignored with year/month, account or pocket filters).",
     "type": "string",
     "minLength": 1,
     "maxLength": 50
    },
    "tags": {
     "description": "Any of these tags (same restriction as category).",
     "maxItems": 10,
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30
     }
    },
    "page": {
     "default": 1,
     "type": "integer",
     "minimum": 1,
     "maximum": 9007199254740991
    },
    "limit": {
     "default": 50,
     "type": "integer",
     "minimum": 1,
     "maximum": 200
    }
   },
   "additionalProperties": false
  },
  "annotations": {
   "title": "List movements",
   "readOnlyHint": true,
   "destructiveHint": false,
   "openWorldHint": false
  }
 },
 {
  "name": "finance_spending_summary",
