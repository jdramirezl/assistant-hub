{
  "name": "assistant-hub",
  "version": "0.1.0",
  "description": "Personal assistant hub: Mastra agent + Telegram + MCP apps",
  "scripts": {
    "dev": "mastra dev",
    "build": "mastra build",
    "start": "node .mastra/output/index.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "LIVE=1 vitest run tests/live",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test",
    "stub:echo": "tsx stub/echo-server.ts",
    "digest": "tsx --env-file-if-exists=.env scripts/digest.ts",
    "setup:mac": "scripts/setup-mac.sh",
    "deploy": "scripts/deploy.sh",
    "backup": "scripts/backup.sh"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@ai-sdk/google": "4.0.99",
    "@libsql/client": "0.18.0",
    "@mastra/core": "1.78.0",
    "@mastra/libsql": "1.26.2",
    "@mastra/mcp": "2.4.1",
    "@mastra/memory": "1.38.0",
    "@mastra/telegram": "0.2.2",
    "chat": "4.42.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "mastra": "1.34.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  }
}
