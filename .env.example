# Copy to .env and `chmod 600 .env`. Never commit .env.
# Values "CHANGEME" (or empty) are treated as NOT configured.

# --- Models (Gemini, paid prepaid tier) ---
GOOGLE_API_KEY=CHANGEME

# --- Telegram (create bots with @BotFather; use a DIFFERENT bot on dev vs server) ---
TELEGRAM_BOT_TOKEN=CHANGEME
# Your numeric user id (from @userinfobot). Telegram stays OFF while this is empty.
TELEGRAM_ALLOWED_USER_IDS=CHANGEME

# --- Apps (MCP servers; referenced by name from mcp-servers.json) ---
# Server Mac (prod): https://finance-app-backend-ten.vercel.app/mcp + ~/.config/finance-mcp/prod.token
# Dev laptop: leave CHANGEME (finance skipped) or point at a PREVIEW deployment + preview.token + bypass.
FINANCE_MCP_URL=CHANGEME
FINANCE_MCP_TOKEN=CHANGEME
# Only for Vercel preview deployments (x-vercel-protection-bypass); leave unset in prod.
FINANCE_MCP_BYPASS=

# --- Ops ---
# healthchecks.io ping URL (https://hc-ping.com/<uuid>)
HEALTHCHECK_URL=CHANGEME
MASTRA_TELEMETRY_DISABLED=1

# --- Optional overrides ---
# HUB_DATA_DIR=/Users/<you>/Library/Application Support/assistant-hub
# HUB_HOST=127.0.0.1
# HUB_PORT=4111
# HUB_TIMEZONE=America/Bogota
# DAILY_TOKEN_CAP=2000000
# DAILY_COST_CAP_USD=0.5
# MCP_REGISTRY_PATH=/absolute/path/to/mcp-servers.json
