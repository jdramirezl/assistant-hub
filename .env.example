# Copy to .env and `chmod 600 .env`. Never commit .env.
# Values "CHANGEME" (or empty) are treated as NOT configured.

# --- Models (Gemini, paid prepaid tier) ---
GOOGLE_API_KEY=CHANGEME

# --- Telegram (create bots with @BotFather; use a DIFFERENT bot on dev vs server) ---
TELEGRAM_BOT_TOKEN=CHANGEME
# Your numeric user id (from @userinfobot). Telegram stays OFF while this is empty.
TELEGRAM_ALLOWED_USER_IDS=CHANGEME

# --- Apps (MCP servers in mcp-servers.json). An app is used only where its URL is set. ---
# MyFitnessPal (Mason, server Mac only): http://127.0.0.1:8484/mcp
MFP_MCP_URL=
# Echo stub for development (npm run stub:echo): http://127.0.0.1:8585/mcp
ECHO_MCP_URL=
# Server Mac (prod): https://finance-app-backend-ten.vercel.app/mcp + ~/.config/finance-mcp/prod.token
# Dev laptop: leave CHANGEME (finance skipped) or point at a PREVIEW deployment + preview.token + bypass.
FINANCE_MCP_URL=CHANGEME
FINANCE_MCP_TOKEN=CHANGEME
# Only for Vercel preview deployments (x-vercel-protection-bypass); leave unset in prod.
FINANCE_MCP_BYPASS=

# --- Ops ---
# healthchecks.io ping URL (https://hc-ping.com/<uuid>)
HEALTHCHECK_URL=CHANGEME
MASTRA_TELEMETRY_DISABLED=1

# --- Persona ---
# alfred (default): formal butler addressing "Amo Julián" / "Master Julian"; plain: neutral.
# HUB_PERSONA=alfred
# Language for proactive notices (startup ping, digest, …): es (default) or en. Replies follow the user.
# HUB_LANGUAGE=es
# OWNER_NAME=Julián

# --- Dev / tests only (never on the server Mac) ---
# Live tests and `npm run replay` use this key, from a SEPARATE Google project, and refuse
# the production key: free-tier quotas are per project and shared with the bot.
# REPLAY_GOOGLE_API_KEY=
# Hard stop per replay run (Gemini HTTP calls, 429s included). Default 120.
# REPLAY_MAX_CALLS=120

# --- Optional overrides ---
# Node that launchd runs (absolute, >= 22.13). Default: auto-detect a stable install
# (Homebrew node@24/node, nodejs.org /usr/local/bin/node, or `node` on PATH).
# NODE_BIN=/usr/local/bin/node
# HUB_DATA_DIR=/Users/<you>/Library/Application Support/assistant-hub
# HUB_HOST=127.0.0.1
# HUB_PORT=4111
# HUB_TIMEZONE=America/Bogota
# DAILY_TOKEN_CAP=2000000
# DAILY_COST_CAP_USD=1
# MCP_REGISTRY_PATH=/absolute/path/to/mcp-servers.json
